{
  "name": "just-download-the-tweet",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Chrome extension that adds download controls to media posts on X.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "i18n:bootstrap": "node tools/i18n/bootstrap-all-locales.mjs",
    "i18n:bootstrap-locale": "node tools/i18n/bootstrap-locale.mjs",
    "i18n:check": "node tools/i18n/check-i18n.mjs && node tools/i18n/audit-title-case.mjs",
    "i18n:audit": "node tools/i18n/audit-translations.mjs",
    "i18n:audit-literals": "node tools/i18n/audit-literals.mjs",
    "i18n:apply-patches": "node tools/i18n/apply-locale-patches.mjs",
    "package:release": "node tools/package-release.mjs",
    "verify": "npm run i18n:check && npm run i18n:audit && npm run i18n:audit-literals && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.32",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.15.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
